.curve-gallery span{color:#bdc8d8;padding:12px 14px;font-size:11px;display:block}.review-columns{grid-template-columns:1fr 1fr;gap:18px;display:grid}.review-columns>div{align-content:start;gap:9px;display:grid}.review-columns article{border:1px solid var(--line);background:#fff;grid-template-columns:42px 1fr;gap:12px;padding:17px;display:grid}.review-columns article>span{color:var(--blue);font-size:11px}.review-columns h3{margin:0 0 7px;font-size:16px}.review-columns p{color:var(--muted);margin:0;font-size:12px}.final-path{border:1px solid var(--line);background:#fff;margin-top:34px;padding:24px}.final-path>div{grid-template-columns:repeat(7,1fr);gap:6px;display:grid}.final-path>div span{text-align:center;color:#687789;justify-items:center;gap:7px;font-size:10px;display:grid}.final-path>div b{width:34px;height:34px;color:var(--blue);background:#eaf2ff;border-radius:50%;place-items:center;display:grid}.final-path img{object-fit:contain;width:min(820px,100%);max-height:290px;margin:28px auto 0;display:block}.final-quote{background:var(--navy);color:#fff;margin-top:22px;padding:46px}.final-quote span{color:#89b3ff;letter-spacing:.13em;font-size:11px}.final-quote h2{max-width:900px;font-size:36px}.final-quote p{color:#abb9ca;line-height:1.8}.next-direction{border-left:4px solid var(--blue)}footer{color:#9baabd;background:#0a1423;grid-template-columns:180px 1fr auto;align-items:center;gap:18px;padding:28px max(5vw,50vw - 660px);font-size:11px;display:grid}footer b{color:#7fa9f5;letter-spacing:.12em}footer button{color:#c7d3e2;cursor:pointer;background:0 0;border:1px solid #324058;padding:9px 12px}@media (width<=1000px){.topbar{grid-template-columns:190px 1fr}.page-count{display:none}nav{justify-content:flex-end;overflow:auto}.hero{grid-template-columns:1fr .55fr}.process-line{grid-template-columns:repeat(3,1fr)}.stage-detail{grid-template-columns:1fr 1fr}.stage-detail img{grid-column:1/-1}.curve-gallery{grid-template-columns:1fr}.role-grid{grid-template-columns:1fr 1fr}}